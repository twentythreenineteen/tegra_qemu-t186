		status = "disabled";
		instance = <0x32>;
		ivc = <0x16 0x6f>;
		mempool = <0x1a>;
	};

	tegra_virt_storage9 {
		compatible = "nvidia,tegra-virt-mtd-storage";
		status = "okay";
		ivc = <0x16 0x70>;
		mempool = <0x1b>;
	};

	tegra_virt_storage10 {
		compatible = "nvidia,tegra-hv-storage";
		status = "okay";
		instance = <0x03>;
		ivc = <0x16 0x71>;
		mempool = <0x1c>;
	};

	tegra_udrm {
		compatible = "nvidia:tegra_udrm";
		linux,phandle = <0x143>;
		phandle = <0x143>;
	};

	arm-pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0x140 0x04 0x00 0x141 0x04 0x00 0x128 0x04 0x00 0x129 0x04 0x00 0x12a 0x04 0x00 0x12b 0x04>;
		interrupt-affinity = <0x92 0x93 0x70 0x72 0x73 0x74>;
	};

	denver-pmu {
		compatible = "nvidia,denver15-pmu";
		interrupts = <0x00 0x122 0x04>;
		interrupt-affinity = <0x92>;
	};

	energy-costs {

		core-cost0 {
			busy-cost-data = <0x400 0x400>;
			idle-cost-data = <0x80>;
			linux,phandle = <0x8e>;
			phandle = <0x8e>;
		};

		core-cost1 {
			busy-cost-data = <0x2f0 0x400>;
			idle-cost-data = <0x80>;
			linux,phandle = <0x91>;
			phandle = <0x91>;
		};
	};

	serial@31f0000 {
		compatible = "nvidia,tegra20-uart";
		reg = <0x00 0x31f0000 0x00 0x40>;
		reg-shift = <0x02>;
		interrupts = <0x00 0x120 0x04>;
		status = "okay";
		clock-frequency = <0x18519600>;
		linux,phandle = <0x144>;
		phandle = <0x144>;
	};

	tegra_hv_wdt_handler {
		compatible = "nvidia,tegra-hv-wdt-handler";
		status = "okay";
		ivc = <0x16 0xcc>;
	};

	tegra_hv_err_handler {
		compatible = "nvidia,tegra-hv-err";
		status = "okay";
	};

